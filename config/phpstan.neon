parameters:
	reportUnmatchedIgnoredErrors: false
	treatPhpDocTypesAsCertain: false
	bootstrapFiles:
		- ../stubs/functions.php
	twigstan:
		# set to true by the config file of the phase PHPStan runs for, see README.md
		phases:
			templateContextCollecting: false
			blockContextCollecting: false
			analysis: false
attributeServicesDirectories:
	- ../src
parametersSchema:
	twigstan: structure([
		twigEnvironmentLoader: string()
		analysisResultJsonFile: string()
		mode: string()
		debugMode: bool()
		appUserClass: schema(string(), nullable())
		environmentFingerprint: schema(string(), nullable())
		phases: structure([
			templateContextCollecting: bool()
			blockContextCollecting: bool()
			analysis: bool()
		])
	])
services:
	# the attribute services of the Twig extensions need it in every phase
	-
		class: Twig\Environment
		factory: @TwigStan\Twig\TwigFactory::create
