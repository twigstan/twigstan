<?php

namespace Twig;

/**
 * Declared so that PHPStan's stub validator, which only sees stub files, knows the class.
 */
class Environment {}

namespace Twig\Extension;

/**
 * Types the arguments of arrow functions, such as `users|filter(user => user.admin)`.
 * The return types of these filters are refined by TwigStan\PHPStan\DynamicReturnType\Filter.
 */
final class CoreExtension
{
    /**
     * @template TKey = mixed
     * @template TValue = mixed
     *
     * @param iterable<TKey, TValue> $array
     * @param \Closure(TValue, TKey): mixed $arrow
     *
     * @return iterable<TKey, TValue>
     */
    public static function filter(\Twig\Environment $env, bool $isSandboxed, $array, $arrow) {}

    /**
     * @template TKey = mixed
     * @template TValue = mixed
     * @template TResult = mixed
     *
     * @param iterable<TKey, TValue> $array
     * @param \Closure(TValue, TKey): TResult $arrow
     *
     * @return array<TKey, TResult>
     */
    public static function map(\Twig\Environment $env, bool $isSandboxed, $array, $arrow) {}

    /**
     * @template TKey = mixed
     * @template TValue = mixed
     *
     * @param iterable<TKey, TValue> $array
     * @param \Closure(TValue, TKey): mixed $arrow
     *
     * @return TValue|null
     */
    public static function find(\Twig\Environment $env, bool $isSandboxed, $array, $arrow) {}

    /**
     * @template TKey = mixed
     * @template TValue = mixed
     * @template TCarry = mixed
     *
     * @param iterable<TKey, TValue> $array
     * @param \Closure(TCarry, TValue, TKey): TCarry $arrow
     * @param TCarry|null $initial
     *
     * @return TCarry
     */
    public static function reduce(\Twig\Environment $env, bool $isSandboxed, $array, $arrow, $initial = null) {}

    /**
     * @template TKey = mixed
     * @template TValue = mixed
     *
     * @param iterable<TKey, TValue> $array
     * @param (\Closure(TValue, TValue): int)|null $arrow
     *
     * @return array<TKey, TValue>
     */
    public static function sort(\Twig\Environment $env, bool $isSandboxed, $array, $arrow = null): array {}

    // Twig passes the string to PHP's string functions without strict types, so scalars are converted to strings.

    /**
     * @param scalar|\Stringable|null $string
     * @param string|null $characterMask
     * @param string $side left, right, or both
     */
    public static function trim($string, $characterMask = null, $side = 'both'): string|\Stringable {}

    /**
     * @param scalar|\Stringable|null $string
     * @param string $to
     * @param string $from
     */
    public static function convertEncoding($string, $to, $from): string {}

    /**
     * @param scalar|\Stringable|null $string
     */
    public static function nl2br($string): string {}

    /**
     * @param scalar|\Stringable|null $string
     * @param string[]|string|null $allowable_tags
     */
    public static function striptags($string, $allowable_tags = null): string {}

    /**
     * @param scalar|\Stringable|null $string
     */
    public static function upper(string $charset, $string): string {}

    /**
     * @param scalar|\Stringable|null $string
     */
    public static function lower(string $charset, $string): string {}

    /**
     * @param scalar|\Stringable|null $string
     */
    public static function titleCase(string $charset, $string): string {}

    /**
     * @param scalar|\Stringable|null $string
     */
    public static function capitalize(string $charset, $string): string {}
}
